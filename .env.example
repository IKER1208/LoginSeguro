# ============================================================
# LoginSeguro — Configuración de Entorno
# ============================================================
# SEGURIDAD: Este archivo es un TEMPLATE. No contiene secretos reales.
# Copiar a .env y completar con valores reales.
# NUNCA commitear el archivo .env al repositorio.
# ============================================================

APP_NAME=LoginSeguro
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# PRODUCCIÓN: APP_DEBUG=false, APP_ENV=production
APP_URL=http://localhost

# ============================================================
# LOGGING
# ============================================================
LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_SECURITY_CHANNEL=security
LOG_LEVEL=debug
# PRODUCCIÓN: LOG_LEVEL=warning

# ============================================================
# BASE DE DATOS
# ============================================================
# SEGURIDAD: En producción, crear un usuario MySQL dedicado
# con permisos SOLO de SELECT, INSERT, UPDATE, DELETE.
# NO usar 'root'. Ejemplo:
#   CREATE USER 'loginseguro_app'@'localhost' IDENTIFIED BY 'password_fuerte';
#   GRANT SELECT, INSERT, UPDATE, DELETE ON loginseguro.* TO 'loginseguro_app'@'localhost';
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=loginseguro
DB_USERNAME=root
DB_PASSWORD=

# ============================================================
# SESIONES — CONFIGURACIÓN SEGURA
# ============================================================
# SEGURIDAD: El driver 'database' es requerido para que
# logoutOtherDevices() funcione correctamente.
SESSION_DRIVER=database
SESSION_LIFETIME=15
# SEGURIDAD: Cifra los datos de sesión en reposo
SESSION_ENCRYPT=true
# SEGURIDAD: Protección CSRF máxima
SESSION_SAME_SITE=strict
# SEGURIDAD: Solo enviar cookie por HTTPS
# LOCAL: false (HTTP), PRODUCCIÓN: true (HTTPS obligatorio)
SESSION_SECURE_COOKIE=false

# ============================================================
# HASHING
# ============================================================
# Argon2id por defecto. Si PHP no tiene ext-sodium, usar 'bcrypt'
# HASHING_DRIVER=argon2id

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ============================================================
# CORREO
# ============================================================
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# ============================================================
# GOOGLE reCAPTCHA v2
# ============================================================
# Obtén tus claves en: https://www.google.com/recaptcha/admin
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# ============================================================
# CORS (producción)
# ============================================================
# CORS_ALLOWED_ORIGINS=https://tudominio.com
